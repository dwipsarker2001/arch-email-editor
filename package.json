{
  "name": "arch-email-editor",
  "version": "1.0.0",
  "description": "Framework-agnostic, embeddable drag-and-drop email editor",
  "type": "module",
  "main": "./dist/arch-email-editor.umd.js",
  "module": "./dist/arch-email-editor.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/arch-email-editor.js",
      "require": "./dist/arch-email-editor.umd.js"
    },
    "./style.css": "./dist/arch-email-editor.css",
    "./react": {
      "import": "./packages/react/index.ts",
      "types": "./packages/react/index.ts"
    },
    "./vue": {
      "import": "./packages/vue/index.ts",
      "types": "./packages/vue/index.ts"
    }
  },
  "files": [
    "dist",
    "packages"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly",
    "test": "vitest run"
  },
  "keywords": [
    "email-editor",
    "newsletter",
    "drag-and-drop",
    "wysiwyg",
    "framework-agnostic",
    "react",
    "vue"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "jsdom": "^26.0.0",
    "react": "^19.3.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vue": "^3.5.44"
  }
}
